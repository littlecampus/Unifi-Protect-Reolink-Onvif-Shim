{
  "schema_version": 1,
  "client_user": "unifi-protect",
  "defaults": {
    "limits": {
      "max_active_requests": 4,
      "max_request_bytes": 262144,
      "max_response_bytes": 4194304,
      "connect_timeout": 5,
      "client_timeout": 10,
      "response_timeout": 120,
      "drain_timeout": 20
    },
    "wsa_repair": ["To", "Action"],
    "wsa_must_understand": true
  },
  "status": {
    "heartbeat_seconds": 5,
    "summary_log_seconds": 900,
    "log_lines_per_minute": 30
  },
  "cameras": [
    {
      "id": "parking_east",
      "name": "Parking East",
      "camera_ip": "10.48.20.13",
      "onvif_port": 8000,
      "listen_port": 18113,
      "enabled": true,
      "mode": "passthrough"
    },
    {
      "id": "batch_camera_a",
      "name": "Placeholder: next pilot camera (documentation address)",
      "camera_ip": "192.0.2.21",
      "onvif_port": 8000,
      "listen_port": 18121,
      "enabled": false,
      "mode": "passthrough"
    },
    {
      "id": "batch_camera_b",
      "name": "Placeholder: camera whose ONVIF needs MessageID too",
      "camera_ip": "192.0.2.22",
      "onvif_port": 8000,
      "listen_port": 18122,
      "enabled": false,
      "wsa_repair": ["To", "Action", "MessageID"],
      "limits": {"response_timeout": 90}
    },
    {
      "id": "ai_camera_example",
      "name": "Placeholder: AI-capable Reolink, opt-in AI motion",
      "camera_ip": "192.0.2.23",
      "onvif_port": 8000,
      "listen_port": 18123,
      "enabled": false,
      "mode": "ai_motion",
      "ai_motion": {"off_hold_seconds": 10, "max_motion_seconds": 900}
    }
  ]
}
